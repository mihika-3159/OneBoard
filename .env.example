# OneBoard Environment Variables Template
APP_NAME=OneBoard
VERSION=1.0.0
DEBUG=false

# Storage & Database
DATABASE_URL=sqlite:///./data/oneboard.db

# Centralized Local Ollama Model Gateway
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL_PROFILE=balanced

# Optional Cloud Model Fallbacks (Leave empty for 100% offline air-gapped local execution)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
