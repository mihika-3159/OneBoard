# Synthetic local development only. Never commit private credentials.
APP_NAME=OneBoard
DEBUG=false
ONEBOARD_DEMO_MODE=false
ONEBOARD_PRODUCTION_MODE=false
DATABASE_URL=sqlite:///./data/oneboard.db
AUTH_SECRET_KEY=replace-with-a-unique-random-development-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API-server inference only; users do not install or download models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL_PROFILE=balanced
OLLAMA_REMOTE_APPROVED=false
OLLAMA_REMOTE_HOST=
# Production only AFTER owner approves eligible hosting and infrastructure:
# COOKIE_SECURE=true
# PUBLIC_API_ORIGIN=https://api.example.invalid
# TRUSTED_PROXY_IPS=127.0.0.1
# DATABASE_URL=postgresql+psycopg://.../oneboard?sslmode=verify-full
